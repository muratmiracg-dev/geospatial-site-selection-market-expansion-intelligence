{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/candidate_scores.schema.json",
  "title": "Candidate score record",
  "type": "object",
  "required": [
    "candidate_id",
    "candidate_name",
    "latitude",
    "longitude",
    "predicted_sales_try_m",
    "opening_cost_try_m",
    "location_score",
    "location_rank",
    "decision_status"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "candidate_name": {
      "type": "string",
      "minLength": 1
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "predicted_sales_try_m": {
      "type": "number",
      "minimum": 0
    },
    "opening_cost_try_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cannibalization_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "location_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "location_rank": {
      "type": "integer",
      "minimum": 1
    },
    "decision_status": {
      "const": "Human review required"
    }
  },
  "additionalProperties": true
}

