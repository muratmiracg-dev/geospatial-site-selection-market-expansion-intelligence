table ScenarioSummary
	lineageTag: 9bcff94c-e8c2-45ae-a0a7-c4573487d13a

	measure 'Selected Stores' = SUM(ScenarioSummary[selected_store_count])
		formatString: 0

	measure 'Budget Used TRY m' = SUM(ScenarioSummary[budget_used_try_m])
		formatString: #,0.0

	measure 'Budget Utilization' = DIVIDE(SUM(ScenarioSummary[budget_used_try_m]), SUM(ScenarioSummary[budget_try_m]))
		formatString: 0.0%

	measure 'Incremental Covered Population' = SUM(ScenarioSummary[incremental_covered_population])
		formatString: #,0

	measure 'Market Coverage Rate' = MAX(ScenarioSummary[market_coverage_rate])
		formatString: 0.0%

	measure 'Portfolio Sales TRY m' = SUM(ScenarioSummary[portfolio_sales_try_m])
		formatString: #,0.0

	column scenario
		dataType: string
		sourceColumn: scenario

	column selected_store_count
		dataType: int64
		sourceColumn: selected_store_count

	column budget_try_m
		dataType: double
		sourceColumn: budget_try_m

	column budget_used_try_m
		dataType: double
		sourceColumn: budget_used_try_m

	column incremental_covered_population
		dataType: int64
		sourceColumn: incremental_covered_population

	column market_coverage_rate
		dataType: double
		sourceColumn: market_coverage_rate

	column portfolio_sales_try_m
		dataType: double
		sourceColumn: portfolio_sales_try_m

	column solver_status
		dataType: string
		sourceColumn: solver_status

	partition ScenarioSummary = m
		mode: import
		source =
				let
				    Root = ProjectRoot,
				    Source = Csv.Document(File.Contents(Root & "/artifacts/data/scenario_summaries.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    Headers

