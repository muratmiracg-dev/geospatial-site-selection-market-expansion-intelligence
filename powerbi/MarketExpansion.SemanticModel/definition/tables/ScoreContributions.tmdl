table ScoreContributions
	lineageTag: 271036bb-1168-4f88-b017-a7606fa90509

	column candidate_id
		dataType: string
		sourceColumn: candidate_id

	column factor
		dataType: string
		sourceColumn: factor

	column raw_value
		dataType: double
		sourceColumn: raw_value

	column normalized_value
		dataType: double
		sourceColumn: normalized_value

	column weight
		dataType: double
		sourceColumn: weight

	column score_contribution
		dataType: double
		sourceColumn: score_contribution

	partition ScoreContributions = m
		mode: import
		source =
				let
				    Root = ProjectRoot,
				    Source = Csv.Document(File.Contents(Root & "/artifacts/data/score_contributions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
				in
				    Headers

